# ============================================================
# USE_MOCK:
#   true  -> every LLM node reads backend/app/data/*_llm_mock.json
#   false -> every LLM node calls real Qwen (dashscope).
#           JSON-parse failures retry once, then fall back to mock.
# explainer_agent uses force_real=True; always calls Qwen when possible
# and falls back to explanation_cache.json on failure.
# ============================================================
USE_MOCK=false

# LLM Provider: qwen or deepseek
LLM_PROVIDER=deepseek

# Qwen (dashscope) API key from https://dashscope.console.aliyun.com/
# Required when USE_MOCK=false and LLM_PROVIDER=qwen.
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Qwen model name
QWEN_MODEL=qwen-plus

# DeepSeek Configuration
# Required when USE_MOCK=false and LLM_PROVIDER=deepseek.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ============================================================
# POI_BACKEND:
#   amap -> live calls to 高德 Web API (requires AMAP_KEY)
#   mock -> read backend/app/data/poi_pool.json
# If amap is selected but AMAP_KEY is missing or the call fails,
# the service automatically falls back to MockPOIBackend.
# ============================================================
POI_BACKEND=amap

# 高德 Web 服务 Key from https://console.amap.com/dev/key/app
# Required when POI_BACKEND=amap.
AMAP_KEY=your_amap_key_here

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
