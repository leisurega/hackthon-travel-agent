# ============================================================
# USE_MOCK:
#   true  (default for hackathon MVP) -> every LLM node reads
#          backend/app/data/*_llm_mock.json instead of calling Qwen.
#   false -> every LLM node calls real Qwen (dashscope).
# Flip this flag to switch between mock-driven and LLM-driven runs.
# explainer_agent uses force_real=True so it always calls Qwen
# when USE_MOCK=true too, with explanation_cache.json as fallback.
# ============================================================
USE_MOCK=true

# Qwen (dashscope) API key from https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Qwen model name
QWEN_MODEL=qwen-plus

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
